rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /spots/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.anclaId == request.auth.uid;
      // El Ancla edita lo suyo; cualquier usuario solo puede pasar "disponible" a "reservado".
      allow update: if request.auth != null && (
        resource.data.anclaId == request.auth.uid ||
        (resource.data.estado == 'disponible'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
          && request.resource.data.estado == 'reservado')
      );
      allow delete: if false;
    }
  }
}
